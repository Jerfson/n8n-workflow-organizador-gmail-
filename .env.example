# ==============================================================================
# Variáveis de Ambiente - Organizador de E-mails Gmail (n8n)
# Copie este arquivo para .env e preencha com seus dados reais:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Configurações do Workflow
# ------------------------------------------------------------------------------
# E-mail que receberá os alertas caso o fluxo encontre falhas ou erros
ALERT_EMAIL=seu-email@gmail.com

# ID do Chat no Telegram para receber alertas de e-mails URGENTES (opcional)
# Para descobrir seu Chat ID, envie /start para @userinfobot no Telegram
TELEGRAM_CHAT_ID=123456789

# ------------------------------------------------------------------------------
# Configurações do n8n (caso execute via Docker Compose)
# ------------------------------------------------------------------------------
# Fuso horário para os agendamentos (Cron)
GENERIC_TIMEZONE=America/Sao_Paulo
TZ=America/Sao_Paulo

# Porta local do n8n
N8N_PORT=5678

# Chave de criptografia de credenciais do n8n (gere uma string aleatória segura de 32+ caracteres)
N8N_ENCRYPTION_KEY=sua_chave_de_criptografia_aleatoria_aqui

# URL pública do webhook (se for usar webhooks externos ou túnel como ngrok/Cloudflare)
# WEBHOOK_URL=https://n8n.seu-dominio.com/
